{
  "manifest_version": 3,
  "name": "Chetavani — Arkiv Anti-Scam Shield",
  "version": "1.0.0",
  "description": "Community-run scam protection for India on Arkiv DB-Chain. Warns against phishing, fake loan portals, and digital arrest traps.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chetavani Shield",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["live-registry.json", "logo.jpg"],
      "matches": ["<all_urls>"]
    }
  ]
}
