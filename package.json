{
  "name": "chetavani-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Chetavani (चेतावनी) — Community-run, self-expiring scam registry for India on Arkiv DB-Chain",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build",
    "seed": "npm --workspace=apps/seed run seed",
    "generate-wallets": "npm --workspace=apps/seed run generate-wallets"
  },
  "keywords": [
    "arkiv",
    "tiramisu",
    "crops",
    "censorship-resistance",
    "anti-scam",
    "india"
  ],
  "author": "Chetavani Team",
  "license": "MIT"
}
